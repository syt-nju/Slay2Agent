# LLM API key for your chosen provider.
#
#   OpenRouter (default): generate at https://openrouter.ai/keys
#   OpenAI native:        generate at https://platform.openai.com/api-keys
#   Other providers:      use their respective key format
#
LLM_API_KEY=

# LLM provider base URL.
# Default: https://openrouter.ai/api/v1  (OpenRouter)
# OpenAI native:  https://api.openai.com/v1
# vLLM local:     http://localhost:8000/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Model slug to use. Must be valid for your chosen provider.
# OpenRouter examples: https://openrouter.ai/models
# OpenAI examples:     gpt-4.1, gpt-4.1-mini
# LLM_MODEL=openai/gpt-4.1-mini

# Optional: HTTP timeout (seconds) for LLM calls.
# LLM_TIMEOUT=120

# STS2MCP REST endpoint. Required for `slay2agent inspect` / `play`.
# Default 127.0.0.1:15526 matches the upstream mod (https://github.com/Gennadiyev/STS2MCP).
# STS2MCP_BASE_URL=http://127.0.0.1:15526

# Optional: HTTP timeout (seconds) for STS2MCP calls.
# STS2MCP_TIMEOUT=30

# Optional: agent_state directory (skill library + oracle.md). Default: agent_state
# AGENT_STATE_DIR=agent_state

# Optional: soft cap (in tokens) for oracle_updater when rewriting oracle.md.
# ORACLE_MAX_TOKENS=4000
