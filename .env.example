# OpenRouter API key. Generate at https://openrouter.ai/keys, then paste here.
OPENROUTER_API_KEY=

# Optional: default model slug. If unset, smoke uses openai/gpt-4o-mini.
# Browse models at https://openrouter.ai/models
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: HTTP timeout (seconds) for OpenRouter calls.
# OPENROUTER_TIMEOUT=120

# STS2MCP REST endpoint. Required for `slay2agent inspect` / `run` once F-003 lands.
# Example placeholder — replace with the address printed by the running mod.
# STS2MCP_BASE_URL=http://127.0.0.1:8080

# Optional: HTTP timeout (seconds) for STS2MCP calls.
# STS2MCP_TIMEOUT=30
